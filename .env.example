# Public base URL of the deployed site (used for SEO metadata, sitemap, robots, OG).
# On Vercel this falls back to VERCEL_URL automatically if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER commit the real value or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=roommate-assets
NEXT_PUBLIC_SUPABASE_GOOGLE_REDIRECT_TO=https://your-domain.example.com/api/auth/callback
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Google Maps JavaScript API key (Maps JavaScript API must be enabled in the
# Google Cloud console; restrict the key to your domain). Without it the app
# still works — map areas show a graceful placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional: a styled Map ID from the Cloud console (defaults to DEMO_MAP_ID,
# which is required for Advanced Markers).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# Optional: geocoding endpoint for address autocomplete (defaults to Nominatim).
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org

# Comma-separated emails granted admin-panel access (server-only).
ADMIN_EMAILS=admin@example.com
