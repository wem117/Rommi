# Public base URL of the deployed site (used for SEO metadata, sitemap, robots, OG).
# Production: https://roomi.kz
NEXT_PUBLIC_SITE_URL=https://roomi.kz

# ---------------------------------------------------------------------------
# Self-hosted Supabase (Docker, on the VPS). This is NOT a supabase.co project:
# the API gateway (Kong) fronts auth, PostgREST, Storage and Realtime.
#
# IMPORTANT: this origin is baked into the Content-Security-Policy and into
# next/image's allow-list at BUILD time (see next.config.ts), so it must be set
# for `npm run build` / the Docker build, not just at runtime.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://api.roomi.kz
# The self-hosted ANON_KEY from supabase/docker/.env on the server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-self-hosted-anon-key
# The self-hosted SERVICE_ROLE_KEY. Server-only — REQUIRED at RUNTIME for image
# uploads, the admin panel, moderation and terms-acceptance. NEVER expose it to
# the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-self-hosted-service-role-key
# Optional, server-only. Origin the SERVER uses to reach Supabase.
#
# NEXT_PUBLIC_SUPABASE_URL is the browser-facing hostname and resolves to
# Cloudflare, so server-side calls using it leave the machine and route back —
# measured at 239-805ms versus 3-24ms to the same gateway locally. Point this at
# the gateway on the container network to keep that traffic internal.
#
# Never prefix this with NEXT_PUBLIC_: browsers cannot resolve an internal host.
# Leave unset and the app uses the public URL exactly as before.
# SUPABASE_INTERNAL_URL=http://kong:8000
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=roommate-assets
# Optional fallback only: the browser always uses the current origin, so this is
# used solely in non-browser contexts.
NEXT_PUBLIC_SUPABASE_GOOGLE_REDIRECT_TO=https://roomi.kz/api/auth/callback

# OPTIONAL: Google Maps JavaScript API key (Maps JavaScript API must be enabled
# in the Google Cloud console; restrict the key to your domain). When set, maps
# use Google Maps with marker clustering. When unset, maps automatically fall
# back to Leaflet + OpenStreetMap — no key or billing needed, fully functional.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional: a styled Map ID from the Cloud console (defaults to DEMO_MAP_ID,
# which is required for Advanced Markers).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# Optional: base URL for address autocomplete / reverse geocoding
# (src/lib/utils/geocode.ts). Defaults to the public OpenStreetMap Nominatim
# endpoint, which enforces a strict ~1 request/second usage policy and WILL
# silently rate-limit as traffic grows. For production scale, point this at a
# paid geocoder (Mapbox / Google / LocationIQ) or a self-hosted Nominatim.
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org

# Comma-separated emails granted admin-panel access (server-only).
# REQUIRED in production: if unset, the env allowlist is EMPTY (fail-closed) and
# no email-based admin is granted (profiles.role / site_settings still work).
ADMIN_EMAILS=admin@example.com

# OPTIONAL — Distributed rate limiting (Upstash Redis REST). When both are set,
# API rate limits become a single global window shared across all serverless
# instances instead of per-instance. Without them, an in-memory fallback is used.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# OPTIONAL — Error tracking. Set the server-side Sentry DSN to forward uncaught
# server errors (captured via src/instrumentation.ts) to Sentry. No SDK needed.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Optional release identifier for log/error correlation (defaults to the Vercel
# commit SHA when available).
# APP_RELEASE=
