# Public base URL of the deployed site (used for SEO metadata, sitemap, robots, OG).
# On Vercel this falls back to VERCEL_URL automatically if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=roommate-assets
NEXT_PUBLIC_SUPABASE_GOOGLE_REDIRECT_TO=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
