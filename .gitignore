# Dependencies
node_modules

# Build output
.next
out
next-env.d.ts.bak

# Environment — never commit real credentials.
# The production runtime env file is generated on the VPS by the deploy workflow.
.env
.env.local
.env.*.local
.env.production
.env.development

# OS / editor metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Crawler output and other scratch text dumps
*.txt
!public/.well-known/security.txt
!telegram-service/requirements.txt

# TypeScript incremental build cache (generated)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Local Supabase CLI state and dumps (never the versioned migrations)
schema.sql
supabase/.temp/
supabase/.branches/

# Test / coverage artifacts
coverage

# Telegram service: session files grant full account access and must never
# reach git. Telethon also writes a -journal file while a session db is open.
#
# The whole legacy telegram/ directory is ignored outright: it was an ad-hoc
# pre-telegram-service login script that hardcoded TELEGRAM_API_HASH directly
# in a tracked .py file (superseded by telegram-service/scripts/create_session.py,
# which reads it from .env instead). Ignoring the directory, not just the
# session file inside it, means that hardcoded secret can never be committed
# even if someone later runs a broad `git add`.
telegram/
telegram-service/*.session
telegram-service/*.session-journal
telegram-service/.env
telegram-service/__pycache__/
telegram-service/**/__pycache__/
telegram-service/.venv/
