# Copy to .env and fill in real values. NEVER commit .env — it holds live
# credentials. See README.md for how to obtain/create each one.

# --- Telegram MTProto (my.telegram.org -> API development tools) -----------
TELEGRAM_API_ID=your-numeric-api-id
TELEGRAM_API_HASH=your-api-hash
# Base filename (no extension) for the persistent session. The real file
# (<this>.session) is created by scripts/create_session.py and is gitignored.
TELEGRAM_SESSION_PATH=roomi_session

# --- Extraction -------------------------------------------------------------
# There is nothing to configure. Parsing is deterministic (telegram_parser/):
# no API key, no model, no quota, no per-message cost. Behaviour is changed by
# editing the pattern tables and the tests that pin them, not by env vars.

# --- Supabase (the SAME project the Next.js app uses) -----------------------
# Public origin, e.g. https://api.roomi.kz. Also the origin photo URLs are
# built from, because those are loaded by a BROWSER that cannot resolve an
# internal Docker hostname.
NEXT_PUBLIC_SUPABASE_URL=https://api.roomi.kz
# Server-only. Required — this service authenticates as service-role
# (BYPASSRLS) since telegram_sources/telegram_messages/telegram_listings have
# zero RLS policies for anon/authenticated by design.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: when this service runs on the same host/Docker network as the
# self-hosted Supabase stack, point it at the internal gateway (e.g.
# http://kong:8000) to keep traffic off the public internet — same rationale
# as SUPABASE_INTERNAL_URL in the main app's .env.example. Leave unset to use
# NEXT_PUBLIC_SUPABASE_URL for everything.
# SUPABASE_INTERNAL_URL=http://kong:8000
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=roommate-assets

# --- Filtering and parsing (optional; sensible defaults shown) ---------------
# Weighted-signal threshold below which a message is dropped WITHOUT being
# written to the database at all. 2 == one ordinary housing noun ("квартира").
# Raising it trades inventory for quiet; the thinnest real post we receive
# ("Квартира болек вход") scores exactly 2, so 3+ starts losing listings.
SPAM_MIN_SCORE=2
# How long to hold an album's messages before treating the group as complete.
# Telegram delivers a multi-photo post as N separate events a few hundred
# milliseconds apart, with the caption on only one of them.
ALBUM_WAIT_SECONDS=2.5

# --- Reliability tuning (optional; sensible defaults shown) -----------------
LOG_LEVEL=INFO
# A message whose import fails for a transient reason (Supabase unreachable,
# Storage 5xx) stays UNPROCESSED and is retried on this schedule instead of
# being marked done and lost. Minutes, not hours: without an AI provider there
# is no per-day quota to outlast, and every remaining failure is an outage.
MAX_PROCESS_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=900
RETRY_SWEEP_INTERVAL_SECONDS=300
RETRY_BATCH_SIZE=20
