# Copy to .env and fill in real values. NEVER commit .env — it holds live
# credentials. See README.md for how to obtain/create each one.

# --- Telegram MTProto (my.telegram.org -> API development tools) -----------
TELEGRAM_API_ID=your-numeric-api-id
TELEGRAM_API_HASH=your-api-hash
# Base filename (no extension) for the persistent session. The real file
# (<this>.session) is created by scripts/create_session.py and is gitignored.
TELEGRAM_SESSION_PATH=roomi_session

# --- AI extraction (Google AI Studio -> Get API key) ------------------------
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.0-flash is fast/cheap and sufficient for structured extraction.
GEMINI_MODEL=gemini-2.0-flash

# --- Supabase (the SAME project the Next.js app uses) -----------------------
# Public origin, e.g. https://api.roomi.kz — used as a fallback when
# SUPABASE_INTERNAL_URL is unset.
NEXT_PUBLIC_SUPABASE_URL=https://api.roomi.kz
# Server-only. Required — this service authenticates as service-role
# (BYPASSRLS) since telegram_sources/telegram_messages/telegram_listings have
# zero RLS policies for anon/authenticated by design.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: when this service runs on the same host/Docker network as the
# self-hosted Supabase stack, point it at the internal gateway (e.g.
# http://kong:8000) to keep traffic off the public internet — same rationale
# as SUPABASE_INTERNAL_URL in the main app's .env.example. Leave unset to use
# NEXT_PUBLIC_SUPABASE_URL for everything.
# SUPABASE_INTERNAL_URL=http://kong:8000
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=roommate-assets

# --- Reliability tuning (optional; sensible defaults shown) -----------------
AI_MIN_INTERVAL_SECONDS=1.0
MAX_RETRIES=3
LOG_LEVEL=INFO
